@model BookViewModel

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-danger bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Delete Book</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <form asp-action="Delete" method="post" class="row">
            <input type="hidden" asp-for="Id" />

            <div class="border p-3">

                <div class="form-floating py-2 col-12">
                    <input asp-for="Title" class="form-control" disabled />
                    <label asp-for="Title" class="ms-2"></label>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Author" class="form-control" disabled />
                    <label asp-for="Author" class="ms-2"></label>
                </div>

                <div class="form-floating py-2 col-12">
                    <textarea asp-for="Description" class="form-control" disabled style="height: 150px;"></textarea>
                    <label asp-for="Description" class="ms-2"></label>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="ISBN" class="form-control" disabled />
                    <label asp-for="ISBN" class="ms-2"></label>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Price" class="form-control" disabled />
                    <label asp-for="Price" class="ms-2"></label>
                </div>

                <div class="form-floating py-2 col-12">
                    <input class="form-control" value="@Model.Genre" disabled />
                    <label class="ms-2">Genre</label>
                </div>

                <div class="row pt-3">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-danger form-control">Delete</button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-action="Index" class="btn btn-outline-primary border form-control">
                            Back to List
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>
